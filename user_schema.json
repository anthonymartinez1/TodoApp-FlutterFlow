{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/user.json",
    "title": "User",
    "type": "object",
    "required": [
      "uid",
      "email",
      "display_name",
      "created_time"
    ],
    "properties": {
      "uid": {
        "type": "string",
        "description": "Firebase Authentication UID"
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "display_name": {
        "type": "string"
      },
      "photo_url": {
        "type": "string",
        "format": "uri"
      },
      "birthday": {
        "type": "string",
        "format": "date-time",
        "description": "Firestore timestamp"
      },
      "created_time": {
        "type": "string",
        "format": "date-time",
        "description": "Firestore timestamp"
      }
    },
    "additionalProperties": false
  }
  