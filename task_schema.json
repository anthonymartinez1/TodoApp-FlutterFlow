{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/task.json",
    "title": "Task",
    "type": "object",
    "required": [
      "title",
      "completed",
      "created",
      "user"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "details": {
        "type": "string"
      },
      "completed": {
        "type": "boolean"
      },
      "created": {
        "type": "string",
        "format": "date-time",
        "description": "Firestore timestamp"
      },
      "user": {
        "type": "string",
        "pattern": "^/users/[A-Za-z0-9_-]+$",
        "description": "Firestore document reference path to user"
      }
    },
    "additionalProperties": false
  }
  